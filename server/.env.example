# ============================================================
# WhatsApp Business API - Credentials
# ============================================================
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to version control
# ============================================================

# Meta Cloud API Access Token (System User - permanent)
# Generate: Meta Business Manager → System Users → Generate Token
# Permissions: whatsapp_business_messaging, whatsapp_business_management
WA_ACCESS_TOKEN=your_permanent_access_token_here

# Phone Number ID (from Meta Developer Dashboard → WhatsApp → API Setup)
WA_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID (WABA)
WA_WABA_ID=your_waba_id_here

# App Secret (for webhook signature verification)
# Find: Meta Developer Dashboard → App Settings → App Secret
WA_APP_SECRET=your_app_secret_here

# Webhook Verify Token (custom string you define)
# This is used during webhook verification (GET request from Meta)
WA_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token_here

# ============================================================
# Other Environment Variables (already in application.yml)
# ============================================================
# JWT_SECRET=your-256-bit-secret-key-here-change-in-production
# ENCRYPTION_KEY=your-aes-256-key-here-change-in-production
# REDIS_HOST=localhost
# REDIS_PORT=6379
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
